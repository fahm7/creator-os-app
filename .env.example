# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# Restart the dev server after changing anything here.

# --- Model. Groq by default. ---
# Free key at https://console.groq.com. The free tier allows 8000 tokens per
# minute and counts the requested completion against it, which is why
# lib/model.ts caps a Groq request at 4000 rather than 16000.
GROQ_API_KEY=

# --- Optional. Set this and the app switches to Claude automatically, ---
# --- and the per-minute token limit above stops applying. ---
# ANTHROPIC_API_KEY=

# --- Archive intake. ---
# Transcribes Instagram reels, YouTube videos, TikTok and X links, and reads
# LinkedIn posts. Free tier: 100 requests, no card. https://supadata.ai
# Without this, pasted text still works; links are skipped with a note.
SUPADATA_API_KEY=
# Optional endpoint override. Leave blank for the default.
SUPADATA_BASE_URL=

# --- Database. Supabase dashboard -> Project Settings -> API. ---
NEXT_PUBLIC_SUPABASE_URL=
# Secret: this bypasses row level security. It is read only by lib/db.ts, which
# is marked server-only so it cannot reach the browser. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
